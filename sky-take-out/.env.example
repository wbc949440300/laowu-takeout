# Docker Compose development defaults. Replace every value before using the prod profile.
SKY_JWT_ADMIN_SECRET=replace-with-at-least-32-random-characters
SKY_JWT_USER_SECRET=replace-with-at-least-32-random-characters
SKY_INTERNAL_KEY=replace-with-at-least-32-random-characters
SKY_INTERNAL_ALLOWED_IPS=172.18.0.0/16
SPRING_PROFILES_ACTIVE=dev
SKY_JWT_ISSUER=sky-take-out
SKY_JWT_ADMIN_AUDIENCE=sky-admin
SKY_JWT_USER_AUDIENCE=sky-user
SKY_WECHAT_APPID=your-wechat-appid
SKY_WECHAT_SECRET=your-wechat-secret
SKY_WECHAT_MCHID=your-wechat-mchid
SKY_WECHAT_MCH_SERIAL_NO=your-wechat-mch-serial-no
SKY_WECHAT_PRIVATE_KEY_FILE=/run/secrets/wechat_private_key.pem
SKY_WECHAT_API_V3_KEY=your-wechat-api-v3-key
SKY_WECHAT_CERT_FILE=/run/secrets/wechat_cert.pem
SKY_WECHAT_NOTIFY_URL=https://your-domain/notify/paySuccess
SKY_WECHAT_REFUND_NOTIFY_URL=https://your-domain/notify/refundSuccess
AGENT_CORS_ORIGINS=https://your-domain
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
